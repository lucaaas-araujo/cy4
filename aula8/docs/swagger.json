{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "Biblioteca Digital API",
    "description": "Documentação da API da Biblioteca Digital"
  },
  "host": "localhost:3000",
  "basePath": "/api",
  "schemes": ["http"],
  "paths": {
    "/books": {
      "get": {
        "summary": "Listar todos os livros",
        "description": "Retorna uma lista com todos os livros cadastrados na biblioteca.",
        "responses": {
          "200": {
            "description": "Lista de livros retornada com sucesso"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      },
      "post": {
        "summary": "Criar um novo livro",
        "description": "Adiciona um novo livro à biblioteca digital.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Dados do livro a ser criado",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "O Senhor dos Anéis"
                },
                "author": {
                  "type": "string",
                  "example": "J.R.R. Tolkien"
                },
                "year": {
                  "type": "integer",
                  "example": 1954
                },
                "genre": {
                  "type": "string",
                  "example": "Fantasia"
                }
              },
              "required": ["title", "author"]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Livro criado com sucesso"
          },
          "400": {
            "description": "Requisição inválida (ex: falta do título ou tipo incorreto)"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "summary": "Buscar um livro por ID",
        "description": "Retorna os detalhes de um livro específico com base no seu ID do MongoDB.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do livro (MongoDB ObjectId)",
            "example": "651a2b3c4d5e6f7a8b9c0d1e"
          }
        ],
        "responses": {
          "200": {
            "description": "Livro encontrado com sucesso"
          },
          "404": {
            "description": "Livro não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      },
      "patch": {
        "summary": "Atualizar um livro",
        "description": "Atualiza parcialmente os dados de um livro existente pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do livro a ser atualizado",
            "example": "651a2b3c4d5e6f7a8b9c0d1e"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Campos do livro a serem atualizados",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "example": "O Hobbit"
                },
                "author": {
                  "type": "string",
                  "example": "J.R.R. Tolkien"
                },
                "year": {
                  "type": "integer",
                  "example": 1937
                },
                "genre": {
                  "type": "string",
                  "example": "Fantasia"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Livro atualizado com sucesso"
          },
          "404": {
            "description": "Livro não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      },
      "delete": {
        "summary": "Excluir um livro",
        "description": "Remove permanentemente um livro da biblioteca pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "ID do livro a ser excluído",
            "example": "651a2b3c4d5e6f7a8b9c0d1e"
          }
        ],
        "responses": {
          "200": {
            "description": "Livro excluído com sucesso"
          },
          "404": {
            "description": "Livro não encontrado"
          },
          "500": {
            "description": "Erro interno do servidor"
          }
        }
      }
    }
  }
}